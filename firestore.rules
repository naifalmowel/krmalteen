rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read-only access for menu items and gallery
    match /menu/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /gallery/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Bookings collection security rules
    match /bookings/{bookingId} {
      // Public visitors can submit pending bookings with valid required fields
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.customerName is string
                    && request.resource.data.phone is string
                    && request.resource.data.guests is int
                    && request.resource.data.guests > 0;

      // Public visitors cannot read, list, update, or delete bookings
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
